\frametitle{Almost Everything is Global Scope}
\begin{pythoncode}
    success = True

    if success:
        desc = "winner!"
    else:
        desc = "loser"

    print(desc)
    \end{pythoncode}
    \begin{block}{}
        \begin{itemize}
            \item Only functions may define a new scope (local or enclosing)
            \item Other statements and loops does not define new scopes
        \end{itemize}
    \end{block}
